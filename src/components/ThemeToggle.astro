<button
  id="theme-toggle"
  type="button"
  aria-label="Switch color theme"
  title="Switch color theme"
  class="grid h-9 w-9 place-items-center rounded-full text-ink transition-colors hover:bg-wash"
>
  <svg class="h-[18px] w-[18px] transition-transform duration-500 dark:rotate-180" viewBox="0 0 20 20" aria-hidden="true">
    <circle cx="10" cy="10" r="8.25" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
    <path d="M10 1.75a8.25 8.25 0 0 1 0 16.5z" fill="currentColor"></path>
  </svg>
</button>

<script>
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const isDark = document.documentElement.classList.toggle('dark');
    try {
      localStorage.setItem('theme', isDark ? 'dark' : 'light');
    } catch {}
  });
</script>
