---
import type { CollectionEntry } from 'astro:content';
import FormattedDate from './FormattedDate.astro';
interface Props {
  posts: CollectionEntry<'blog'>[];
}
const { posts } = Astro.props;
---

<ol class="border-t border-rule">
  {
    posts.map((post) => (
      <li data-reveal class="border-b border-rule">
        <a href={`/blog/${post.id}`} class="group grid grid-cols-12 items-baseline gap-x-4 gap-y-1 py-6">
          <FormattedDate date={post.data.pubDate} class="label col-span-12 md:col-span-2" />
          <span class="col-span-12 md:col-span-6">
            <span class="text-xl font-medium transition-colors group-hover:text-accent">{post.data.title}</span>
          </span>
          <span class="col-span-12 text-muted md:col-span-4">{post.data.description}</span>
        </a>
      </li>
    ))
  }
</ol>
