---
import { site } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="mx-auto mt-20 max-w-page px-5 pb-10 sm:px-8">
  <div class="grid grid-cols-12 gap-x-4 gap-y-6 border-t border-ink pt-6 text-[0.9rem] text-muted">
    <p class="col-span-12 md:col-span-4">© {year} {site.name}</p>
    <p class="col-span-12 md:col-span-4">
      Set in Instrument Serif &amp; Schibsted Grotesk. Built with Astro{
        site.source && (
          <>
            {' '}—{' '}
            <a href={site.source} class="link text-ink" target="_blank" rel="noopener">
              view source
            </a>
          </>
        )
      }.
    </p>
    <div class="col-span-12 flex gap-6 md:col-span-4 md:justify-end">
      <a href="/rss.xml" class="link">RSS</a>
      <a href="#main" class="link">Back to top ↑</a>
    </div>
  </div>
</footer>
