---
import SectionHeading from './SectionHeading.astro';
import { site } from '../data/site';
---

<section class="pb-8 pt-20 md:pt-28" aria-labelledby="contact">
  <SectionHeading index="05" title="Contact" id="contact" />

  <div class="grid grid-cols-12 gap-x-4 gap-y-10">
    <div class="col-span-12 md:col-span-11 md:col-start-2">
      <p data-reveal class="max-w-2xl text-lg text-ink/80">
        Hiring, or have a project in mind? I reply to every email, usually within a day.
      </p>

      <div data-reveal class="mt-8 flex flex-wrap items-end gap-x-6 gap-y-4">
        <a
          href={`mailto:${site.email}`}
          class="link break-all font-serif text-[clamp(2.25rem,1rem+5vw,5.5rem)] leading-none tracking-tight hover:text-accent"
        >
          {site.email}
        </a>
        <button
          id="copy-email"
          type="button"
          data-email={site.email}
          class="label mb-2 rounded-full border border-rule px-3 py-1.5 text-ink transition-colors hover:border-ink"
        >
          <span>Copy</span>
        </button>
      </div>

      <ul data-reveal class="mt-12 flex flex-wrap gap-x-8 gap-y-3">
        {
          site.socials.map((s) => (
            <li>
              <a href={s.href} target="_blank" rel="me noopener" class="link">
                {s.label} ↗
              </a>
            </li>
          ))
        }
        {
          site.resume && (
            <li>
              <a href={site.resume} class="link">
                Résumé (PDF) ↗
              </a>
            </li>
          )
        }
      </ul>
    </div>
  </div>
</section>

<script>
  const btn = document.getElementById('copy-email');
  const label = btn?.querySelector('span');
  btn?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(btn.dataset.email!);
      if (label) label.textContent = 'Copied';
    } catch {
      if (label) label.textContent = 'Press Ctrl+C';
    }
    setTimeout(() => label && (label.textContent = 'Copy'), 2000);
  });
</script>
