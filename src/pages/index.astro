---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Intro from '../components/Intro.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ProjectIndex from '../components/ProjectIndex.astro';
import AboutSection from '../components/AboutSection.astro';
import PostList from '../components/PostList.astro';
import ContactSection from '../components/ContactSection.astro';
import StackSection from '../components/StackSection.astro';

const all = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const featured = all.filter((p) => p.data.featured);

const posts = (await getCollection('blog', ({ data }) => import.meta.env.DEV || !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<BaseLayout>
  <Intro />

  <section class="py-20 md:py-28" aria-labelledby="work">
    <SectionHeading
      index="01"
      title="Selected work"
      id="work"
      href={all.length > featured.length ? '/projects' : undefined}
      linkLabel={`All projects (${all.length})`}
    />
    <ProjectIndex projects={featured} />
  </section>

  <AboutSection />

  <StackSection index="03" />

  {
    posts.length > 0 && (
      <section class="py-20 md:py-28" aria-labelledby="writing">
        <SectionHeading index="04" title="Writing" id="writing" href="/blog" linkLabel="All writing" />
        <PostList posts={posts} />
      </section>
    )
  }

  <ContactSection />
</BaseLayout>
